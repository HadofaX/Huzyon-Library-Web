@model List<Huzyon.Library.Models.Favorite>

@{
    ViewData["Title"] = "Favorites";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">⭐ Favorite Products</h2>
        <p class="text-muted mb-0">
            View customers' favorite products and their details.
        </p>
    </div>

    
    <span class="badge bg-primary fs-6">
        Total Favorites: @(Model?.Count ?? 0)
    </span>
    

</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            @if (Model != null && Model.Any())
            {
                <table class="table table-striped table-hover table-bordered mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Customer ID</th>
                            <th scope="col">Product ID</th>
                            <th scope="col">Favorite Date</th>
                            <th scope="col">Price</th>
                            <th scope="col">Favorite Count</th>
                        </tr>
                    </thead>

                    
                    <tbody>
                        @foreach (var fav in Model)
                        {
                            <tr>
                                <td>@fav.CustomerID</td>
                                <td>@fav.ProductID</td>
                                <td>@fav.FavoriteDate.ToShortDateString()</td>
                                <td>@fav.Price</td>
                                <td>@fav.FavoriteCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    No favorite products found.
                </div>
            }
        </div>
    </div>
    

</div>


